{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DataRelay Labs",
  "description": "A central portal for DataRelay Labs products, product documentation, and practical source-available engineering.",
  "colors": {
    "primary": "#16A34A"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/datarelay-labs"
      },
      {
        "label": "Engineering System",
        "href": "https://engineering.datarelay.run/"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Browse Projects",
      "href": "/projects"
    }
  },
  "search": {
    "prompt": "Search DataRelay Labs..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://datarelay.run"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "DataRelay Labs",
            "icon": "grid-2",
            "pages": [
              "index",
              "choose-project",
              "projects",
              "project-map",
              "principles"
            ]
          }
        ]
      },
      {
        "language": "ko",
        "groups": [
          {
            "group": "DataRelay Labs",
            "icon": "grid-2",
            "pages": [
              "ko/index",
              "ko/choose-project",
              "ko/projects",
              "ko/project-map",
              "ko/principles"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://datarelay.run"
  },
  "favicon": "/favicon.svg"
}
