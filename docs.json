{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DataRelay Labs",
  "description": "A central portal for DataRelay Labs products, product documentation, and practical source-available engineering.",
  "colors": {
    "primary": "#C2410C",
    "light": "#FB923C",
    "dark": "#C75A00"
  },
  "navbar": {
    "links": [
      {
        "label": "DataRelay",
        "href": "https://datarelay.run/"
      },
      {
        "label": "Link",
        "href": "https://link.datarelay.run/"
      },
      {
        "label": "Control",
        "href": "https://control.datarelay.run/"
      },
      {
        "label": "Grant",
        "href": "https://grant.datarelay.run/"
      },
      {
        "label": "Engineering",
        "href": "https://engineering.datarelay.run/"
      },
      {
        "type": "github",
        "href": "https://github.com/datarelay-labs"
      }
    ]
  },
  "search": {
    "prompt": "Search DataRelay Labs..."
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://datarelay.run"
    }
  },
  "metadata": {
    "timestamp": true
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "DataRelay Labs",
            "icon": "grid-2",
            "pages": [
              "index",
              "choose-project",
              "projects",
              "project-map",
              "principles"
            ]
          }
        ]
      },
      {
        "language": "ko",
        "groups": [
          {
            "group": "DataRelay Labs",
            "icon": "grid-2",
            "pages": [
              "ko/index",
              "ko/choose-project",
              "ko/projects",
              "ko/project-map",
              "ko/principles"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://datarelay.run"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  }
}
